# Live mode (required); never commit real values.
GITHUB_ORG=your-organization
GITHUB_TOKEN=replace-with-your-token
AUTH_SECRET=replace-with-a-random-secret
AUTH_GITHUB_ID=replace-with-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-client-secret
AUTH_URL=http://localhost:3000

# Public presentation settings (set before building).
LOCALE=en
TIME_ZONE=UTC
ORG_DISPLAY_NAME=
READY_LABEL=ready-for-review
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# Optional people configuration.
CTO_LOGIN=
IGNORED_LOGINS=coderabbitai,sonarcloud,sonarqubecloud
EXCLUDED_LOGINS=
# Optional example: {"alice":"an-id-from-the-character-manifest"}
CHARACTER_OVERRIDES=

# Use pnpm demo for a credential-free fictional replay.
# DEMO_MODE=1

# AUTH_TRUST_HOST=true # Only behind a trusted reverse proxy.
# ASSET_DIR=/path/to/downloaded-assets # Import scripts only.
# E2E_BYPASS_AUTH=1 # Local nonproduction tests only; keep unset for deployments.
